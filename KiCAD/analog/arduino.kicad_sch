	(text "J2 -  Output LPF\nJ31 - SS PA\nJ35 - Future tube PA"
		(exclude_from_sim no)
		(at 112.268 173.228 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "193e098f-9fed-40a5-bfc0-a19a58335987")
	)
	(text "Out of date Documentation: I2C bus and +3.3V routed off-board via STEMMA QT cable\nfrom Metro JST-SH port to Si5351 breakout (VFO sheet).\nSi5351 breakout 0.1\" header distributes SDA/SCL/+3V3/GND\nto other I2C devices via PCB traces."
		(exclude_from_sim no)
		(at 20.32 176.022 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "31a7a86d-b80b-43ce-9051-30004f42240e")
	)
	(text "J6 - Transmit/Receive Relay\nJ7 - High Voltage Primary\nJ10 - High Voltage Inrush limiter\n\nEach relay requires a 1N4001 at the coil."
		(exclude_from_sim no)
		(at 223.012 40.64 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "45405003-8a90-4e46-a598-ae746a5ee296")
	)
	(text "Heartbeat failure warning light\nR can be as low as 270R if LED\ndoes not have internal resistor"
		(exclude_from_sim no)
		(at 213.36 157.48 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "4ca6fad0-5e76-45e1-8978-b6ebb3e82574")
	)
	(text "Power to barrel connector\non Metro"
		(exclude_from_sim no)
		(at 98.298 106.172 0)
		(effects
