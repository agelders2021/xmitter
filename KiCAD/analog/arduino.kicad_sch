				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "61f7875b-a82a-42fe-af3d-3b67883053e0")
	)
	(text "J10 connects to the paddle. \nFunction of D5 and D6 can be swapped in software."
		(exclude_from_sim no)
		(at 106.68 36.068 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
