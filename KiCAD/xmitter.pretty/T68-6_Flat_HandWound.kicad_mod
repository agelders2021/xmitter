(footprint "T68-6_Flat_HandWound"
	(version 20240108)
	(generator "manual")
	(generator_version "9.0")
	(layer "F.Cu")
	(descr "T68-6 iron powder toroid (Micrometals/Amidon mix 6, yellow, A_L=47 nH/N^2), hand-wound, laying flat on PCB with axis perpendicular to board. Both leads exit on the same radial side; outer lead sits just outside the OD (17.53 mm), inner lead sits inside the ID hole (9.40 mm). Pitch center-to-center 7.5 mm. Suits 4-turn 22/24 AWG magnet wire winding for 20 m LPF (nominal 752 nH). Silk shows OD and ID circles.")
