(footprint "Relay_SPDT_Omron_G6RL-1"
	(version 20240108)
	(generator "manual")
	(generator_version "10.0")
	(layer "F.Cu")
	(descr "Omron G6RL-1 SPDT PCB power relay (fits all G6RL-1(4)-(ASI)-(PL) variants). Low-profile 12.3mm height, 28.5x10.0mm body. 5 pins all through-hole Ø1.3mm. Pin 1 (coil+) upper-left, Pin 5 (coil-) lower-left: left column 7.62mm vertical. Pin 2 (NC) upper-right, Pin 3 (NO) lower-right (directly below pin 2), 7.62mm vertical. Pin 4 (COM, moving contact) lower, 3.2mm to the left of pin 3. Pin 1 to Pin 2 horizontal: 18.9mm. SPDT (1c form) with Pin 4 default to Pin 2 (NC) when coil de-energized, Pin 4 to Pin 3 (NO) when coil energized. 10A/250VAC or 5A/30VDC NO contact rating. See Documentation/Components/en_g6rl.pdf.")
	(tags "relay SPDT 1-pole low-profile through-hole Omron G6RL")
