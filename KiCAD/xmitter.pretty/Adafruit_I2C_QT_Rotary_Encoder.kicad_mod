(footprint "Adafruit_I2C_QT_Rotary_Encoder"
	(version 20240108)
	(generator "manual")
	(generator_version "9.0")
	(layer "F.Cu")
	(descr "Adafruit I2C QT Rotary Encoder breakout (PID 4991). Onboard SAMD09 running seesaw firmware handles quadrature decoding, pushbutton debounce, and NeoPixel. Board 1.00 x 1.00 in (25.4 x 25.4 mm), 4 corner mounting holes on 0.90 in spacing (22.86 mm). One 6-pin 0.1 in header row along the bottom edge: VIN, GND, SCL, SDA, INT, 3Vo (left to right). Default I2C address 0x36; address jumpers on the back set 0x36-0x3D. STEMMA QT connectors on the side edges are NOT represented -- user is installing via the included 0.1 in header. Onboard 10K I2C pull-ups, VIN bypass caps, and 3V3 LDO regulator all live on the breakout module.")
	(tags "adafruit i2c qt rotary encoder seesaw pec11 stemma quadrature")
