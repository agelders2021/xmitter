(footprint "T68-6_Vertical_HandWound"
	(version 20240108)
	(generator "manual")
	(generator_version "9.0")
	(layer "F.Cu")
	(descr "T68-6 iron powder toroid (Micrometals/Amidon mix 6, yellow, A_L=47 nH/N^2), hand-wound, standing on edge with axis parallel to PCB. Top-down projection = rectangle OD (17.53 mm) x HT (4.83 mm). Two leads exit from opposite sides of the standing toroid: pad 1 above (north), pad 2 below (south), each offset slightly along the OD axis for the natural lead exit angle after 4-turn winding. Vertical mount reduces magnetic coupling to adjacent horizontal toroids. Anchor with nylon tie or hot glue after winding. For 20 m LPF (nominal 752 nH with 4 turns 22 AWG).")
	(tags "toroid iron powder t68-6 amidon micrometals hand wound vertical edge")
