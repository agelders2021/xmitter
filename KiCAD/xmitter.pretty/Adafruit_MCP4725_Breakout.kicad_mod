(footprint "Adafruit_MCP4725_Breakout"
	(version 20240108)
	(generator "manual")
	(generator_version "9.0")
	(layer "F.Cu")
	(descr "Adafruit MCP4725 12-bit single-channel I2C DAC breakout. Board 25.4 x 17.78 mm (1.00 x 0.70 in), 4 corner mounting holes on 20.32 x 12.70 mm (0.80 x 0.50 in) spacing. Single 6-pin 0.1 in header along the bottom edge (0.10 in / 2.54 mm from board edge), labeled left-to-right: VIN, GND, SCL, SDA, A0, VOUT. The 'optional terminal' pads shown on the fab print (near the top center of the breakout) are for the user to solder in a small 2-pin screw terminal for the DAC output; they sit on the breakout PCB above the parent-board surface and are not represented here. A0 is the I2C address jumper (leave open = 0x62, tie high = 0x63). Dimensions verified against Adafruit fab print 2026-07-15.")
	(tags "adafruit mcp4725 i2c dac breakout")
