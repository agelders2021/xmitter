(footprint "BN43-2402_Vertical_HandWound"
	(version 20240108)
	(generator "manual")
	(generator_version "10.0")
	(layer "F.Cu")
	(descr "Fair-Rite BN43-2402 small binocular ferrite core (type 43 material, 7.52 x 7.52 x 5.08 mm per Fair-Rite 2843002402 datasheet; two 1.52 mm dia bores on 2.54 mm pitch). Mounted VERTICALLY (standing on end) with bore axis perpendicular to PCB. Hand-wound, 2 pads for a simple single-winding RF choke (used in Rev D for L18 on ss_pa, as the +12V bias feed RFC to T3 center-tap). Wires exit DOWNWARD from the bottom bore ends and bend outward to meet the two PCB pads flanking the core footprint. VERIFY body and bore dimensions against actual stock before fab.")
	(tags "ferrite binocular bn43-2402 fair-rite type-43 vertical hand-wound choke rfc")
