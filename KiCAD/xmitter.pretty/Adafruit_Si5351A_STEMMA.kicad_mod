(footprint "Adafruit_Si5351A_STEMMA"
	(version 20240108)
	(generator "manual")
	(generator_version "9.0")
	(layer "F.Cu")
	(descr "Adafruit Si5351A clock generator STEMMA QT breakout - mounts on M2.5 standoffs above PCB, 10 jumper wires from breakout pin holes down to landing pads. Two 5-pin rows: TOP row = CLK2 / GND / CLK1 / GND / CLK0 (with GND spacers for RF isolation between clocks); BOTTOM row = VIN / 3V / GND / SDA / SCL. Board 25.4 x 17.78 mm (1.00 x 0.70 in), mounting holes at 20.32 x 12.70 mm (0.80 x 0.50 in), pin rows share Y with mounting holes at +/-6.35 mm - all verified against physical breakout 2026-07-08.")
	(tags "adafruit si5351a clock generator stemma qt breakout")
