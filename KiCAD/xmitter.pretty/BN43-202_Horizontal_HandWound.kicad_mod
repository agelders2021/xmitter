(footprint "BN43-202_Horizontal_HandWound"
	(version 20240108)
	(generator "manual")
	(generator_version "10.0")
	(layer "F.Cu")
	(descr "Fair-Rite BN43-202 large binocular ferrite core (type 43 material, 12.70 x 7.52 x 6.35 mm per Fair-Rite 2843000202 datasheet; two 2.74 mm dia bores on 4.95 mm pitch). Mounted HORIZONTALLY (lying flat, bore axis parallel to PCB and parallel to the long side of the core, QRP Labs kit style). Hand-wound, 4 pads: pins 1,2 = primary winding (two ends), pins 3,4 = secondary winding (two ends). Used in Rev D for T1 output transformer on ss_pa: pins 1,2 = IRF510 PP drains (primary), pins 3,4 = output (3 = GND, 4 = RF out). The center tap of the primary (when needed) comes externally from T2's drain-feed midpoint, not from the T1 symbol. VERIFY body and bore dimensions against actual stock before fab.")
	(tags "ferrite binocular bn43-202 fair-rite type-43 horizontal flat hand-wound transformer output")
