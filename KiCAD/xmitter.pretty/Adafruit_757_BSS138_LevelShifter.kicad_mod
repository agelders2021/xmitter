(footprint "Adafruit_757_BSS138_LevelShifter"
	(version 20240108)
	(generator "manual")
	(generator_version "10.0")
	(layer "F.Cu")
	(descr "Adafruit #757 4-channel I2C-safe Bi-directional Logic Level Converter breakout (BSS138-based). PCB approximately 20.3 x 14.0 mm. Two 6-pin 0.1 inch headers on the long edges, row-to-row centerline distance 12.7 mm (0.5 inch). LV side (left column, pins 1-6): LV, GND, LV1, LV2, LV3, LV4. HV side (right column, pins 7-12): HV, GND, HV1, HV2, HV3, HV4. Both GND pins are tied together on the breakout. 10K pull-ups to LV and HV already present on the breakout; no external pull-ups needed when the breakouts downstream also carry pull-ups. VERIFY actual row-to-row spacing against physical stock before fab.")
	(tags "Adafruit level-shifter BSS138 I2C bidirectional 757 breakout")
