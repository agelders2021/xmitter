	(text "I2C bus and +3.3V routed off-board via STEMMA QT cable\nfrom Metro JST-SH port to Si5351 breakout (VFO sheet).\nSi5351 breakout 0.1\" header distributes SDA/SCL/+3V3/GND\nto other I2C devices via PCB traces."
		(exclude_from_sim no)
		(at 60.96 110.49 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "31a7a86d-b80b-43ce-9051-30004f42240e")
	)
	(text "J6 - Transmit/Receive Relay\nJ7 - High Voltage Primary\nJ8 - High Voltage Inrush limiter\n\nEach relay requires a 1N4001 at the coil."
		(exclude_from_sim no)
		(at 223.012 40.64 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "45405003-8a90-4e46-a598-ae746a5ee296")
	)
	(text "J10 connects to the paddle. \nFunction of D5 and D6 can be swapped in software."
		(exclude_from_sim no)
		(at 120.65 48.514 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "64d60ac5-b44d-4667-b09a-f4d90d9bf472")
	)
	(text "J9 goes to the second set of contacts on\nthe transmit/receive relay. This is the source of\nTR_SENSE which confirms that the\nrelay is in the correct state. (It switches between\nGND and +3.3V)"
		(exclude_from_sim no)
		(at 151.13 111.76 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "8d885fa5-83f5-4965-ab38-e2563a651b05")
	)
	(text "Reserved for future front-panel INT cable.\nWired-OR of STEP + FUNC QT encoder INT pins plus PCF8575 INT.\nLeave J5 unpopulated on first build; see front_panel_interface.md\n\"Interrupt handling (decision: none)\" section for rationale."
		(exclude_from_sim no)
		(at 43.18 96.52 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left top)
		)
		(uuid "e0000005-0000-4000-8000-000000000001")
	)
	(text "I2C pull-ups provided by Si5351A breakout\n      (10 kΩ to 3.3 V). No additional pull-ups needed."
		(exclude_from_sim no)
		(at 108.204 122.682 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "ea69adec-6365-42f5-a951-8ec28a1b13ad")
	)
