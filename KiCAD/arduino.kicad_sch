	(text "J8 goes to the second set of contacts on\nthe transmit/receive relay. This is the source of\nTR_SENSE which confirms that the\nrelay is in the correct state. (It switches between\nGND and +3.3V)"
		(exclude_from_sim no)
		(at 139.192 95.504 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "8d885fa5-83f5-4965-ab38-e2563a651b05")
	)
	(text "Reserved for future front-panel INT cable.\nWired-OR of STEP + FUNC QT encoder INT pins plus PCF8575 INT.\nLeave J5 unpopulated on first build; see front_panel_interface.md\n\"Interrupt handling (decision: none)\" section for rationale."
		(exclude_from_sim no)
		(at 43.18 96.52 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left top)
		)
		(uuid "e0000005-0000-4000-8000-000000000001")
	)
