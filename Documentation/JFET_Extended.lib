+  Is=33.57f Isr=322.4f N=1 Nr=2 Xti=3
+  Alpha=311.7u Vk=243.6
+  Cgd=1.6p M=0.3622 Pb=1 Fc=0.5 Cgs=2.414p
+  Kf=9.882E-18 Af=1)
.ENDS
  </Spice>
  <SpiceAttach >
</Component>

