(footprint "RJ45_Amphenol_RJE1D-188-X1X01_Horizontal_TabDown"
  (version 20221018)
  (generator manual)
  (layer "F.Cu")
  (descr "Amphenol RJE1D-188-X1X01, modular jack 1x1 8P8C, shielded with top and side tabs, tab down, horizontal edge mount, no LED. Origin at midpoint between the two 3.0mm locating posts. PCB edge 8.80mm in front of post centers (marked on Dwgs.User); front of housing overhangs board edge by ~4.5mm. Per Amphenol drawing P-RJE1D-188-X1X01 Rev B.")
  (tags "RJ45 8P8C modular jack shielded amphenol RJE1D-188 connector ethernet")
  (attr through_hole)

  (fp_text reference "REF**" (at 0 -8.7) (layer "F.SilkS")
    (effects (font (size 1 1) (thickness 0.15)))
  )
  (fp_text value "RJE1D-188-X1X01" (at 0 4.4) (layer "F.Fab")
    (effects (font (size 1 1) (thickness 0.15)))
  )
  (fp_text user "${REFERENCE}" (at 0 -1.7) (layer "F.Fab")
    (effects (font (size 1 1) (thickness 0.15)))
  )
  (fp_text user "PCB edge" (at 0 9.6) (layer "Dwgs.User")
    (effects (font (size 0.8 0.8) (thickness 0.12)))
  )

  ;; ------------------------------------------------------------------
  ;; Silkscreen (board-side portion of housing only; nose overhangs edge)
  ;; ------------------------------------------------------------------
  (fp_line (start -7.62 -7.71) (end 7.62 -7.71) (stroke (width 0.12) (type solid)) (layer "F.SilkS"))
  (fp_line (start -7.62 -7.71) (end -7.62 5.3) (stroke (width 0.12) (type solid)) (layer "F.SilkS"))
  (fp_line (start 7.62 -7.71) (end 7.62 5.3) (stroke (width 0.12) (type solid)) (layer "F.SilkS"))
  ;; pin 1 indicator (bottom pin row, left side)
  (fp_line (start -6.1 -3.26) (end -6.1 -4.66) (stroke (width 0.12) (type solid)) (layer "F.SilkS"))
  (fp_line (start -6.1 -4.66) (end -5.4 -3.96) (stroke (width 0.12) (type solid)) (layer "F.SilkS"))
  (fp_line (start -5.4 -3.96) (end -6.1 -3.26) (stroke (width 0.12) (type solid)) (layer "F.SilkS"))

  ;; ------------------------------------------------------------------
  ;; Fabrication layer: full housing outline (15.00 wide x 20.88 deep)
  ;; ------------------------------------------------------------------
  (fp_line (start -7.5 -7.59) (end 7.5 -7.59) (stroke (width 0.1) (type solid)) (layer "F.Fab"))
  (fp_line (start -7.5 -7.59) (end -7.5 13.29) (stroke (width 0.1) (type solid)) (layer "F.Fab"))
  (fp_line (start 7.5 -7.59) (end 7.5 13.29) (stroke (width 0.1) (type solid)) (layer "F.Fab"))
  (fp_line (start -7.5 13.29) (end 7.5 13.29) (stroke (width 0.1) (type solid)) (layer "F.Fab"))
  ;; pin 1 chamfer indicator on fab
  (fp_line (start -7.5 -6.59) (end -6.5 -7.59) (stroke (width 0.1) (type solid)) (layer "F.Fab"))

  ;; ------------------------------------------------------------------
  ;; PCB edge reference (8.80 in front of post centers)
  ;; ------------------------------------------------------------------
  (fp_line (start -9.5 8.8) (end 9.5 8.8) (stroke (width 0.12) (type dash)) (layer "Dwgs.User"))

  ;; ------------------------------------------------------------------
  ;; Courtyard (0.5 mm clearance, includes shield pads and overhang)
  ;; ------------------------------------------------------------------
  (fp_line (start -9.13 -8.09) (end 9.13 -8.09) (stroke (width 0.05) (type solid)) (layer "F.CrtYd"))
  (fp_line (start -9.13 -8.09) (end -9.13 13.79) (stroke (width 0.05) (type solid)) (layer "F.CrtYd"))
  (fp_line (start 9.13 -8.09) (end 9.13 13.79) (stroke (width 0.05) (type solid)) (layer "F.CrtYd"))
  (fp_line (start -9.13 13.79) (end 9.13 13.79) (stroke (width 0.05) (type solid)) (layer "F.CrtYd"))

  ;; ------------------------------------------------------------------
  ;; Signal contacts: dr 0.90, staggered rows 2.54 apart, 2.54 pitch,
  ;; rows offset 1.27 (pins 2,4,6,8 rear row; 1,3,5,7 front row)
  ;; ------------------------------------------------------------------
  (pad "1" thru_hole circle (at -4.445 -3.96) (size 1.5 1.5) (drill 0.9) (layers "*.Cu" "*.Mask"))
  (pad "2" thru_hole circle (at -3.175 -6.5) (size 1.5 1.5) (drill 0.9) (layers "*.Cu" "*.Mask"))
  (pad "3" thru_hole circle (at -1.905 -3.96) (size 1.5 1.5) (drill 0.9) (layers "*.Cu" "*.Mask"))
  (pad "4" thru_hole circle (at -0.635 -6.5) (size 1.5 1.5) (drill 0.9) (layers "*.Cu" "*.Mask"))
  (pad "5" thru_hole circle (at 0.635 -3.96) (size 1.5 1.5) (drill 0.9) (layers "*.Cu" "*.Mask"))
  (pad "6" thru_hole circle (at 1.905 -6.5) (size 1.5 1.5) (drill 0.9) (layers "*.Cu" "*.Mask"))
  (pad "7" thru_hole circle (at 3.175 -3.96) (size 1.5 1.5) (drill 0.9) (layers "*.Cu" "*.Mask"))
  (pad "8" thru_hole circle (at 4.445 -6.5) (size 1.5 1.5) (drill 0.9) (layers "*.Cu" "*.Mask"))

  ;; ------------------------------------------------------------------
  ;; Shield tails: dr 1.57 (1.6), 14.85 apart, 6.79 in front of posts
  ;; ------------------------------------------------------------------
  (pad "SH" thru_hole circle (at -7.425 6.79) (size 2.4 2.4) (drill 1.6) (layers "*.Cu" "*.Mask"))
  (pad "SH" thru_hole circle (at 7.425 6.79) (size 2.4 2.4) (drill 1.6) (layers "*.Cu" "*.Mask"))

  ;; ------------------------------------------------------------------
  ;; Plastic locating posts: dr 3.00 NPTH, 10.00 apart (origin datum)
  ;; ------------------------------------------------------------------
  (pad "" np_thru_hole circle (at -5 0) (size 3 3) (drill 3) (layers "*.Cu" "*.Mask"))
  (pad "" np_thru_hole circle (at 5 0) (size 3 3) (drill 3) (layers "*.Cu" "*.Mask"))
)
