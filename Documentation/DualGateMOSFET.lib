<Qucs Library 0.0.22 "DualGateMOSFET">

<Component BF961>
  <Description>
BF961 N-Channel Dual-Gate Depletion MOSFET (Vishay/Siemens)
RF tetrode for VHF amplifiers and mixers to 300 MHz.
VDS=20V ID=30mA Ptot=200mW NF=1.8dB@200MHz SOT-103
Pins: 1=S(Source) 2=D(Drain) 3=G2(AGC/Gate2) 4=G1(RF/Gate1)
Model: two stacked NMOS subcircuit derived from BF981/datasheet.
  </Description>
  <Model>
.Def:DualGateMOSFET_BF961 _net0 _net1 _net2 _net3
Sub:X1 _net0 _net1 _net2 _net3 gnd Type="BF961_cir"
.Def:End
  </Model>
  <Spice>
* BF961 Dual-Gate N-Channel Depletion MOSFET
* Pins: 1=Source 2=Drain 3=Gate2 4=Gate1
.SUBCKT BF961_cir gnd _net0 _net1 _net2 _net3
X1 _net0 _net1 _net2 _net3 nBF961
.ENDS
.SUBCKT nBF961 1 2 3 4
* Package parasitics
L10  1  10  L=0.5N
L20  2  20  L=0.5N
L30  3  30  L=0.3N
L40  4  40  L=0.3N
* Inter-electrode capacitances
C13  10  30  C=0.025P
C14  10  40  C=0.025P
C23  20  30  C=0.025P
* Gate protection diodes
D1  40  99  DPROT961
D2  99  40  DPROT961
D3  30  99  DPROT961
D4  99  30  DPROT961
* Two-MOSFET stack: M1=Gate1(lower), M2=Gate2(upper)
M1   5  40  10  10  MOS1BF961  L=1U  W=50U
M2  20  30   5  10  MOS2BF961  L=1U  W=50U
RS  10  11  2.0
V99  99  0  DC 0
.MODEL DPROT961 D(IS=1E-14 N=1 BV=6.5 IBV=1M RS=50)
.MODEL MOS1BF961 NMOS(LEVEL=1
+  VTO=-1.1   KP=15M    LAMBDA=3.75M
+  GAMMA=3.3U PHI=0.75
+  IS=12.5F   PB=0.8    MJ=0.46
+  CBD=3.43P  CBS=4.11P
+  CGSO=240P  CGDO=200P CGBO=20.5N)
.MODEL MOS2BF961 NMOS(LEVEL=1
+  VTO=-0.9   KP=18M    LAMBDA=13.75M
+  GAMMA=19.08U PHI=0.75
+  IS=12.5F   PB=0.8    MJ=0.46
+  CBD=3.43P  CBS=4.11P
+  CGSO=240P  CGDO=200P CGBO=14.5N)
.ENDS nBF961
  </Spice>
  <SpiceAttach >
  <Symbol>
    <.ID 8 -26 T>
    <Line -10 -11 10 0 #000080 2 1>
    <Line 0 -11 0 -19 #000080 2 1>
    <Line -10 11 10 0 #000080 2 1>
    <Line 0 11 0 19 #000080 2 1>
    <Line -10 0 10 0 #000080 2 1>
    <Line -10 -4 0 8 #000080 3 1>
    <Line -10 7 0 9 #000080 3 1>
    <Line -9 0 5 -5 #000080 2 1>
    <Line -9 0 5 5 #000080 2 1>
    <Line -30 10 16 0 #000080 2 1>
    <Line -30 -10 16 0 #000080 2 1>
    <Line -10 -16 0 9 #000080 3 1>
    <Line -14 -15 0 5 #000080 3 1>
    <Line -14 5 0 5 #000080 3 1>
    <.PortSym 0 30 1 0>
    <.PortSym 0 -30 2 0>
    <.PortSym -30 -10 3 0>
    <.PortSym -30 10 4 0>
  </Symbol>
</Component>

<Component BF981>
  <Description>
BF981 N-Channel Dual-Gate Depletion MOSFET (Philips/NXP)
VHF/UHF amplifier and mixer tetrode to 500 MHz. SOT-143.
VDS=20V ID=30mA Ptot=200mW
Pins: 1=S(Source) 2=D(Drain) 3=G2(AGC/Gate2) 4=G1(RF/Gate1)
  </Description>
  <Model>
.Def:DualGateMOSFET_BF981 _net0 _net1 _net2 _net3
