L10  1  10  L=0.12N
L20  2  20  L=0.12N
L30  3  30  L=0.12N
L40  4  40  L=0.12N
L11  10  11  L=1.20N
L21  20  21  L=1.20N
L31  30  31  L=1.20N
L41  40  41  L=1.20N
C13  10  30  C=0.085P
C14  10  40  C=0.085P
C23  20  30  C=0.020P
C24  20  40  C=0.020P
M1   5  41  11  11  MOS1BF981  L=1U  W=50U
M2  21  31   5  11  MOS2BF981  L=1U  W=50U
D1  41  11  DG981
D2  31  11  DG981
RS  10  11  2.0
RD  20  21  3.0
V99  99  0  DC 0
.MODEL DG981  D(IS=1E-14 BV=10)
.MODEL MOS1BF981 NMOS(LEVEL=1
+  VTO=-1.1   KP=15M    LAMBDA=3.75M
+  GAMMA=3.3U PHI=0.75
+  IS=12.5F   PB=0.8    MJ=0.46
